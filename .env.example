# Environment Variables for GarageLog

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garagelog?schema=public"
# DIRECT_URL is used for migrations if using connection poolers like Supabase Supavisor
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/garagelog?schema=public"

# Auth Session Secret
AUTH_SECRET="garage-log-secret-key-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

